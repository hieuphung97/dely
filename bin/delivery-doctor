#!/usr/bin/env bash
# Check that every rail is actually wired, not merely present.
#
# Written because a rail failed silently. `git-hooks/pre-push` was installed and
# ignored — git printed a hint about the missing execute bit and pushed anyway.
# A guard that is absent without saying so is worse than no guard, because the
# absence is indistinguishable from protection until the day it matters.
#
# Two lessons from this session are encoded here as checks rather than prose:
#   - a configuration listing is not a behavioural test (`grok inspect` said the
#     safety hook was loaded; it was inert)
#   - a fact true of one mechanism is not true of another (plugin hooks are run
#     through `bash`, git hooks are exec'd directly and need the bit)
#
# Usage:  delivery-doctor [repo-path]      defaults to the current directory
# Exit:   0 all checks pass, 1 at least one failed

set -u

repo="${1:-$PWD}"
pkg_root="$(cd "$(dirname "$0")/.." && pwd)"
failures=0

ok()   { printf '  ok    %s\n' "$*"; }
bad()  { printf '  FAIL  %s\n' "$*"; failures=$((failures + 1)); }
warn() { printf '  warn  %s\n' "$*"; }

printf 'delivery-doctor\n'
printf '  package: %s\n' "$pkg_root"
printf '  repo:    %s\n\n' "$repo"

# --- prerequisites --------------------------------------------------------

if command -v jq >/dev/null 2>&1; then
  ok "jq present"
else
  bad "jq missing — the SessionStart hook emits nothing and the reader cannot run"
fi

if command -v git >/dev/null 2>&1; then
  ok "git present"
else
  bad "git missing"
fi

# --- git hook -------------------------------------------------------------

hook="${pkg_root}/git-hooks/pre-push"

if [ -f "$hook" ]; then
  ok "pre-push hook file exists"
  if [ -x "$hook" ]; then
    ok "pre-push hook is executable"
  else
    bad "pre-push hook is NOT executable — git will ignore it and print only a hint"
    printf '        fix: chmod +x %s\n' "$hook"
  fi
else
  bad "pre-push hook missing at $hook"
fi

if [ -d "$repo/.git" ] || git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
  configured=$(git -C "$repo" config --get core.hooksPath 2>/dev/null || printf '')
  remotes=$(git -C "$repo" remote 2>/dev/null || printf '')
  if [ -z "$configured" ] && [ -z "$remotes" ]; then
    # A push guard cannot fire in a repository with nowhere to push. Reporting
    # that as a failure is a false warning, and this package's own findings
    # record a false warning costing two turns of work against a non-problem.
    ok "pre-push rail not applicable — $repo has no remote"
  elif [ -z "$configured" ]; then
    bad "core.hooksPath is not set in $repo — the pre-push rail is not installed"
    printf '        fix: git -C %s config core.hooksPath %s/git-hooks\n' "$repo" "$pkg_root"
  else
    resolved=$(cd "$repo" && cd "$configured" 2>/dev/null && pwd || printf '%s' "$configured")
    if [ "$resolved" = "${pkg_root}/git-hooks" ]; then
      ok "core.hooksPath points here ($configured)"
    else
      warn "core.hooksPath points elsewhere: $configured"
      printf '        another tool may own git hooks in this repo; reconcile before relying on pre-push\n'
    fi
  fi
else
  warn "$repo is not a git repository — skipped hook wiring checks"
fi

# --- claude code plugin hooks --------------------------------------------

hooks_json="${pkg_root}/hooks/hooks.json"
if [ -f "$hooks_json" ] && command -v jq >/dev/null 2>&1; then
  if jq -e . "$hooks_json" >/dev/null 2>&1; then
    events=$(jq -r '.hooks | keys | join(", ")' "$hooks_json" 2>/dev/null)
    ok "hooks.json parses; events: ${events}"
  else
    bad "hooks.json is not valid JSON — Claude Code will load no hooks from this plugin"
  fi
else
  bad "hooks.json missing at $hooks_json"
fi

for script in session-start-context.sh post-tool-journal.sh; do
  path="${pkg_root}/hooks/${script}"
  if [ -f "$path" ]; then
    if bash -n "$path" 2>/dev/null; then
      ok "${script} parses"
    else
      bad "${script} has a syntax error — the hook will fail on every session"
    fi
  else
    bad "${script} missing"
  fi
done

# Grok discovers this plugin and reports has_hooks=true, and then runs none of
# its hooks. Verified 2026-08-20 from its own debug log: the only hook sources it
# executed were ~/.grok/hooks/*.json and ~/.claude/settings.json, while every
# plugin-bundled hook — delivery, cc-safety-net, codex, superpowers — was
# discovered and never dispatched. So a Grok worker journals nothing unless the
# hooks are registered where Grok actually looks.
grok_hook="${HOME}/.grok/hooks/delivery.json"
if command -v grok >/dev/null 2>&1; then
  if [ -f "$grok_hook" ]; then
    if jq -e . "$grok_hook" >/dev/null 2>&1; then
      unexpected_shape=0
      command_count=0
      saw_session_start=0
      saw_post_tool_use=0
      saw_post_tool_use_failure=0
      incomplete_roots=""
      usable_roots=""
      while IFS="$(printf '\t')" read -r grok_event grok_cmd; do
        command_count=$((command_count + 1))
        adapter_root=""
        case "$grok_event:$grok_cmd" in
          SessionStart:bash\ \"*/hooks/session-start-context.sh\"|\
          PostToolUse:bash\ \"*/hooks/post-tool-journal.sh\"|\
          PostToolUseFailure:bash\ \"*/hooks/post-tool-journal.sh\")
            quoted=${grok_cmd#bash \"}
            quoted=${quoted%\"}
            adapter_root=${quoted%/hooks/*}
            ;;
        esac
        if [ -z "$adapter_root" ]; then
          unexpected_shape=1
          continue
        fi
        case "$grok_event" in
          SessionStart) saw_session_start=1 ;;
          PostToolUse) saw_post_tool_use=1 ;;
          PostToolUseFailure) saw_post_tool_use_failure=1 ;;
        esac
        if [ -f "$quoted" ]; then
          case " $usable_roots " in
            *" $adapter_root "*) ;;
            *) usable_roots="${usable_roots:+$usable_roots }$adapter_root" ;;
          esac
        else
          case " $incomplete_roots " in
            *" $adapter_root "*) ;;
            *) incomplete_roots="${incomplete_roots:+$incomplete_roots }$adapter_root" ;;
          esac
        fi
      done < <(jq -r '.hooks | to_entries[] | .key as $event | .value[]?.hooks[]? | "\($event)\t\(.command // "")"' "$grok_hook" 2>/dev/null || true)

      if [ "$unexpected_shape" -eq 1 ]; then
        warn "Grok hook command does not match the template shape (bash \"<root>/hooks/<script>\")"
        printf '        regenerate ~/.grok/hooks/delivery.json from the installed package\n'
      fi
      if [ -n "$incomplete_roots" ]; then
        warn "Grok hook exists but referenced root is missing or incomplete: $incomplete_roots"
        printf '        regenerate ~/.grok/hooks/delivery.json from the installed package\n'
      fi
      missing_events=""
      if [ "$saw_session_start" -eq 0 ]; then
        missing_events="SessionStart"
      fi
      if [ "$saw_post_tool_use" -eq 0 ]; then
        missing_events="${missing_events:+$missing_events }PostToolUse"
      fi
      if [ "$saw_post_tool_use_failure" -eq 0 ]; then
        missing_events="${missing_events:+$missing_events }PostToolUseFailure"
      fi
      if [ -n "$missing_events" ]; then
        warn "Grok hook is missing required event: $missing_events"
        printf '        regenerate ~/.grok/hooks/delivery.json from the installed package\n'
      fi
      if [ "$command_count" -eq 0 ]; then
        warn "Grok hook exists but registers no commands"
      elif [ "$unexpected_shape" -eq 0 ] && [ -z "$incomplete_roots" ] && [ -z "$missing_events" ]; then
        ok "Grok hook registered and referenced root is usable ($usable_roots)"
      fi
    else
      bad "Grok hook is not valid JSON — $grok_hook"
    fi
  else
    bad "Grok is installed but has no delivery hook — a Grok worker records no evidence"
    printf '        Grok ignores plugin-bundled hooks; register them at %s\n' "$grok_hook"
    printf '        using the same three events as hooks/hooks.json, with absolute paths\n'
  fi
fi

# --- managed block --------------------------------------------------------
# The consuming project's AGENTS.md may carry exactly one managed block
# between <!-- dely:begin --> and <!-- dely:end -->. No block is the
# supported fallback, not a failure. Each required phase has exactly one
# row of four non-empty cells. Values in Model and Effort are not
# checked against any catalogue; the literal default is legal.

agents="${repo}/AGENTS.md"
begin_mark='<!-- dely:begin -->'
end_mark='<!-- dely:end -->'

if [ ! -f "$agents" ]; then
  warn "managed block absent — no AGENTS.md; using the supported fallback (current harness, harness defaults)"
else
  begins=$(grep -cF "$begin_mark" "$agents" 2>/dev/null || true)
  ends=$(grep -cF "$end_mark" "$agents" 2>/dev/null || true)
  [ -n "$begins" ] || begins=0
  [ -n "$ends" ] || ends=0

  if [ "$begins" -eq 0 ] && [ "$ends" -eq 0 ]; then
    warn "managed block absent — no markers in AGENTS.md; using the supported fallback (current harness, harness defaults)"
  elif [ "$begins" -gt 1 ]; then
    bad "managed block: more than one begin marker"
  elif [ "$ends" -gt 1 ]; then
    bad "managed block: more than one end marker"
  elif [ "$begins" -eq 0 ]; then
    bad "managed block: end marker with no matching begin"
  elif [ "$ends" -eq 0 ]; then
    bad "managed block: begin with no matching end"
  else
    begin_line=$(awk -v m="$begin_mark" 'index($0, m){print NR; exit}' "$agents")
    end_line=$(awk -v m="$end_mark" 'index($0, m){print NR; exit}' "$agents")
    if [ "$end_line" -le "$begin_line" ]; then
      bad "managed block: end before begin"
    else
      block=$(awk -v b="$begin_line" -v e="$end_line" 'NR>b && NR<e {print}' "$agents")
      block_fail=0
      if ! printf '%s\n' "$block" | grep -Eq '^#{1,6}[[:space:]]+Dely[[:space:]]*$'; then
        bad "managed block: missing Dely heading"
        block_fail=1
      fi
      if ! printf '%s\n' "$block" | grep -Eq '^[[:space:]]*(\*\*)?Coordinator(\*\*)?[[:space:]]*:'; then
        bad "managed block: missing Coordinator line"
        block_fail=1
      fi
      saw_header=0
      saw_control=0
      saw_implement=0
      saw_review=0
      saw_release=0
      while IFS= read -r raw || [ -n "$raw" ]; do
        case "$raw" in
          *'|'*) ;;
          *) continue ;;
        esac
        stripped=$(printf '%s' "$raw" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^|//' -e 's/|$//' -e 's/[[:space:]]*|[[:space:]]*/ | /g' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
        case "$stripped" in
          'Phase | Harness | Model | Effort') saw_header=1; continue ;;
        esac
        first=$(printf '%s' "$stripped" | awk -F ' \\| ' '{print $1}' | tr -d '`' | tr -d '[:space:]')
        case "$first" in
          ---*|:-*) continue ;;
          control|implement|review|release) ;;
          *) continue ;;
        esac
        case "$first" in
          control)
            [ "$saw_control" -eq 0 ] || { bad "managed block: duplicate phase row: control"; block_fail=1; }
            saw_control=1
            ;;
          implement)
            [ "$saw_implement" -eq 0 ] || { bad "managed block: duplicate phase row: implement"; block_fail=1; }
            saw_implement=1
            ;;
          review)
            [ "$saw_review" -eq 0 ] || { bad "managed block: duplicate phase row: review"; block_fail=1; }
            saw_review=1
            ;;
          release)
            [ "$saw_release" -eq 0 ] || { bad "managed block: duplicate phase row: release"; block_fail=1; }
            saw_release=1
            ;;
        esac
        cell_info=$(printf '%s\n' "$raw" | awk -F '|' '
          {
            start=1; end=NF
            if ($1 ~ /^[[:space:]]*$/) start=2
            if ($NF ~ /^[[:space:]]*$/) end=NF-1
            n=end-start+1
            empty=0
            for (i=start; i<=end; i++) {
              val=$i
              gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)
              gsub(/^`+|`+$/, "", val)
              gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)
              if (val == "") empty=1
            }
            print n " " empty
          }')
        n_cells=${cell_info%% *}
        has_empty=${cell_info##* }
        if [ "${n_cells:-0}" -ne 4 ]; then
          bad "managed block: phase row $first does not have four cells"
          block_fail=1
        elif [ "${has_empty:-0}" -eq 1 ]; then
          bad "managed block: empty required cell in phase row: $first"
          block_fail=1
        fi
      done < <(printf '%s\n' "$block")
      if [ "$saw_header" -eq 0 ]; then
        bad "managed block: missing table header Phase | Harness | Model | Effort"
        block_fail=1
      fi
      missing_phases=""
      [ "$saw_control" -eq 1 ] || missing_phases="${missing_phases:+$missing_phases }control"
      [ "$saw_implement" -eq 1 ] || missing_phases="${missing_phases:+$missing_phases }implement"
      [ "$saw_review" -eq 1 ] || missing_phases="${missing_phases:+$missing_phases }review"
      [ "$saw_release" -eq 1 ] || missing_phases="${missing_phases:+$missing_phases }release"
      if [ -n "$missing_phases" ]; then
        bad "managed block: missing phase row: $missing_phases"
        block_fail=1
      fi
      if [ "$block_fail" -eq 0 ]; then
        ok "managed block well formed"
      fi
    fi
  fi
fi

# --- journal --------------------------------------------------------------

journal_dir="${DELIVERY_JOURNAL_DIR:-$HOME/.delivery-journal}"
if [ -d "$journal_dir" ]; then
  count=$(find "$journal_dir" -maxdepth 1 -name '*.raw.jsonl' -type f 2>/dev/null | wc -l | tr -d '[:space:]')
  ok "journal directory exists, ${count} session file(s)"
  if [ "${count:-0}" -eq 0 ]; then
    warn "no sessions recorded yet — run one turn with --plugin-dir to confirm capture"
  fi
else
  warn "no journal at $journal_dir — nothing has been captured yet"
fi

# --- what this cannot check ----------------------------------------------

printf '\n  Not checked here, because only running the thing proves it:\n'
printf '    - whether an inherited guard is honoured by the harness that loaded it\n'
printf '      (Grok discovers plugin hooks and dispatches none of them, so every\n'
printf '       plugin-bundled guard is inert there, not just cc-safety-net)\n'
printf '    - whether a sandbox deny rule fires, which needs a real file at a\n'
printf '      denied path; a non-existent path returns ENOENT and proves nothing\n'

printf '\n'
if [ "$failures" -eq 0 ]; then
  printf 'all checks passed\n'
  exit 0
fi
printf '%d check(s) failed\n' "$failures"
exit 1
