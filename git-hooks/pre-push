#!/usr/bin/env bash
# Refuse pushes that would bypass pull-request review.
#
# Install, once per clone:
#   git config core.hooksPath /path/to/project-delivery-procedure/git-hooks
#
# Why a git hook rather than an agent permission rule: git invokes this
# whatever the push was spelled like. A rule of the form `Bash(git push *)`
# was defeated in one session by a bare `git push` — there is no finite pattern
# set, because the agent chooses the wording. A pre-push hook sits below the
# wording, so `git push`, `git push origin HEAD`, and `git push -f` all reach it.
#
# What it cannot do: `--no-verify` skips it, and an unrestricted agent could
# edit or unset it. This is a guard against accident and drift, not against a
# determined agent.
#
# stdin lines are: <local ref> <local sha> <remote ref> <remote sha>

remote_name="${1:-origin}"

protected_branches="main master"
zero="0000000000000000000000000000000000000000"
status=0
seen=0

# Announce on every run, allowed or refused.
#
# A silent guard cannot be told apart from an absent one. This hook was installed
# without an execute bit once; git printed a single hint line and pushed anyway,
# and nothing in the output distinguished "checked and allowed" from "never ran".
# One line on stderr costs nothing and makes presence observable.
printf 'pre-push: delivery guard active (remote %s)\n' "$remote_name" >&2

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$remote_ref" ] || continue
  seen=$((seen + 1))

  branch="${remote_ref#refs/heads/}"
  deleting=0
  creating=0
  [ "$local_sha" = "$zero" ] && deleting=1
  [ "$remote_sha" = "$zero" ] || [ -z "$remote_sha" ] && creating=1

  is_protected=0
  for candidate in $protected_branches; do
    [ "$branch" = "$candidate" ] && is_protected=1
  done

  if [ "$is_protected" -eq 1 ]; then
    if [ "$deleting" -eq 1 ]; then
      printf 'pre-push: refusing to delete %s on %s\n' "$branch" "$remote_name" >&2
    else
      printf 'pre-push: refusing to push directly to %s on %s — open a pull request\n' \
        "$branch" "$remote_name" >&2
    fi
    status=1
    continue
  fi

  if [ "$deleting" -eq 1 ]; then
    printf 'pre-push: deleting %s on %s\n' "$branch" "$remote_name" >&2
    continue
  fi

  # A new branch has no history to rewrite.
  [ "$creating" -eq 1 ] && continue

  # Anything that is not a fast-forward rewrites history a review may already
  # have read.
  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    printf 'pre-push: refusing non-fast-forward push to %s (%s..%s)\n' \
      "$branch" "${remote_sha:0:8}" "${local_sha:0:8}" >&2
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  printf 'pre-push: refused. Nothing was pushed. Override deliberately with --no-verify.\n' >&2
else
  printf 'pre-push: %d ref update(s) checked, all allowed\n' "$seen" >&2
fi

exit "$status"
